PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/grammarly-clone
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# No other configuration needed — the AI writing engine (spelling, grammar,
# clarity, engagement, delivery, tone, readability) is fully self-contained
# and runs offline with zero third-party APIs and zero API keys.
